{
  "name": "aura-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AURA — Symbiote Intelligence frontend (React + Vite + Zustand + Tailwind + Framer Motion)",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",

    "electron:wait": "wait-on http://localhost:5173 && electron .",
    "electron:dev": "concurrently --kill-others --names \"vite,electron\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run electron:wait\"",
    "electron:build": "cross-env ELECTRON_BUILD=true vite build && electron-builder --mac"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.symbite.app",
    "productName": "Symbite",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "Symbite",
      "backgroundColor": "#050B17"
    }
  }
}
